{
  "name": "@mondave/core",
  "private": true,
  "version": "0.1.0",
  "description": "Mondave Design System — React components and design tokens",
  "type": "module",
  "main": "./src/components/index.ts",
  "types": "./src/components/index.ts",
  "exports": {
    ".": "./src/components/index.ts",
    "./tokens": "./src/styles/generated/tokens.css",
    "./typography": "./src/styles/generated/typography.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src/components",
    "src/styles/generated/tokens.css",
    "src/styles/generated/typography.css",
    "src/styles/tokens"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest --project storybook",
    "mcp:build": "npm --prefix ./mcp run build",
    "mcp:check": "npm --prefix ./mcp run check"
  },
  "dependencies": {
    "lucide-react": "^1.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "storybook": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-mcp": "^0.6.0",
    "eslint-plugin-storybook": "^10.4.6",
    "vitest": "^4.1.9",
    "playwright": "^1.61.0",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9"
  }
}
